.lbmOsLayout {
  min-height: 100vh;
  display: flex;
  background: #f8f5ef;
  color: #202634;
}

.lbmOsSidebar {
  width: 250px;
  min-height: 100vh;
  background: #1e2a44;
  color: white;
  padding: 28px 18px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
}

.lbmOsBrand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 4px 10px 25px;
}

.lbmOsBrandMark {
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,.25);
  display: grid;
  place-items: center;
  font-weight: 700;
  letter-spacing: .04em;
}

.lbmOsBrand strong,
.lbmOsBrand span {
  display: block;
  font-size: 10px;
  letter-spacing: .15em;
}

.lbmOsBrand span {
  opacity: .65;
  margin-top: 3px;
}

.lbmOsLabel {
  font-size: 9px;
  letter-spacing: .16em;
  color: rgba(255,255,255,.45);
  padding: 0 10px 15px;
}

.lbmOsSidebar nav {
  display: grid;
  gap: 4px;
}

.lbmOsNavItem {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 12px;
  color: rgba(255,255,255,.68);
  font-size: 13px;
  transition: .2s ease;
}

.lbmOsNavItem:hover,
.lbmOsNavItem.active {
  background: rgba(255,255,255,.1);
  color: white;
}

.lbmOsSidebarBottom {
  margin-top: auto;
  display: grid;
  gap: 4px;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.1);
}

.lbmOsMain {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: 55px 6vw 90px;
}

.lbmOsHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 42px;
}

.lbmOsEyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .18em;
  color: #a47c12;
  margin: 0 0 12px;
}

.lbmOsHeader h1 {
  font-size: clamp(38px, 5vw, 64px);
  line-height: .98;
  letter-spacing: -.045em;
  margin: 0 0 14px;
  font-weight: 600;
}

.lbmOsHeader p:last-child {
  max-width: 650px;
  color: #6d7280;
  line-height: 1.6;
  margin: 0;
}

.lbmOsCard {
  background: white;
  border: 1px solid #ddd9d0;
  padding: 32px;
}

.lbmOsCard h2 {
  margin-top: 0;
  letter-spacing: -.02em;
}

.lbmOsCard p {
  color: #6d7280;
  line-height: 1.65;
}

.lbmOsEmpty {
  min-height: 330px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.lbmOsEmptyIcon {
  width: 54px;
  height: 54px;
  border: 1px solid #ddd9d0;
  display: grid;
  place-items: center;
  margin-bottom: 20px;
  font-size: 20px;
}

.lbmOsEmpty h2 {
  margin: 0 0 8px;
}

.lbmOsEmpty p {
  max-width: 460px;
  margin: 0 0 25px;
}

.lbmOsButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 18px;
  border: 0;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.lbmOsButton.primary {
  background: #d4af37;
  color: #171717;
}

.lbmOsButton.secondary {
  background: #1e2a44;
  color: white;
}

.lbmOsForm {
  display: grid;
  gap: 22px;
  max-width: 760px;
}

.lbmOsForm label {
  display: grid;
  gap: 7px;
  font-size: 12px;
  font-weight: 700;
}

.lbmOsForm input,
.lbmOsForm textarea {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #ccc9c1;
  background: #fff;
  color: #202634;
  font: inherit;
}

.lbmOsForm input:focus,
.lbmOsForm textarea:focus {
  outline: 2px solid rgba(212,175,55,.35);
  border-color: #d4af37;
}

.lbmOsSuccess {
  padding: 13px;
  background: #e8eee4;
  font-size: 13px;
}

.lbmOsStats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 25px;
}

.lbmOsStat {
  background: white;
  border: 1px solid #ddd9d0;
  padding: 25px;
}

.lbmOsStat span {
  display: block;
  color: #6d7280;
  font-size: 12px;
  margin-bottom: 12px;
}

.lbmOsStat strong {
  font-size: 30px;
  letter-spacing: -.03em;
}

.lbmOsLogout {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #f8f5ef;
}

@media (max-width: 850px) {
  .lbmOsSidebar {
    width: 210px;
  }

  .lbmOsHeader {
    align-items: flex-start;
    flex-direction: column;
  }

  .lbmOsStats {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 650px) {
  .lbmOsLayout {
    display: block;
  }

  .lbmOsSidebar {
    position: relative;
    width: 100%;
    height: auto;
    min-height: auto;
  }

  .lbmOsSidebarBottom {
    margin-top: 20px;
  }

  .lbmOsMain {
    padding: 40px 20px 70px;
  }
}

/* =========================================================
   LBMOS AUTHENTICATION EXPERIENCE
   Premium Little Brush Masters Command Centre
   ========================================================= */

.lbmOsLoginPage {
  min-height: 100vh;
  min-height: 100svh;
  background: #1e2a44;
  color: #202634;
  overflow: hidden;
}

.lbmOsLoginShell {
  min-height: 100vh;
  min-height: 100svh;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(460px, .92fr);
}

/* ---------------------------------------------------------
   CREATIVE PANEL
   --------------------------------------------------------- */

.lbmOsLoginVisual {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 72% 24%,
      rgba(212, 175, 55, .13),
      transparent 27%
    ),
    radial-gradient(
      circle at 25% 78%,
      rgba(155, 177, 150, .13),
      transparent 30%
    ),
    #1e2a44;
  color: #f8f5ef;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 42px clamp(40px, 6vw, 92px);
}

.lbmOsVisualNoise {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .045;
  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
}

.lbmOsLoginVisual .lbmOsBrand {
  position: relative;
  z-index: 3;
  padding: 0;
  gap: 13px;
}

.lbmOsLoginVisual .lbmOsBrandMark {
  width: 46px;
  height: 46px;
  border-color: rgba(255,255,255,.3);
  font-size: 12px;
  letter-spacing: .08em;
}

.lbmOsLoginVisual .lbmOsBrand strong,
.lbmOsLoginVisual .lbmOsBrand span {
  font-size: 10px;
  letter-spacing: .2em;
}

.lbmOsVisualTop {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lbmOsVersion {
  font-size: 9px;
  letter-spacing: .2em;
  color: rgba(255,255,255,.45);
}

.lbmOsVisualContent {
  position: relative;
  z-index: 3;
  max-width: 670px;
  margin: auto 0;
  padding: 80px 0;
}

.lbmOsVisualEyebrow {
  display: block;
  margin-bottom: 26px;
  color: #d4af37;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .24em;
}

.lbmOsVisualContent h2 {
  margin: 0;
  font-size: clamp(58px, 7vw, 112px);
  line-height: .87;
  letter-spacing: -.07em;
  font-weight: 500;
}

.lbmOsVisualContent h2 em {
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
  color: #d4af37;
}

.lbmOsPaintLine {
  width: 110px;
  height: 1px;
  margin: 42px 0 24px;
  background: rgba(212,175,55,.65);
}

.lbmOsVisualContent p {
  max-width: 410px;
  margin: 0;
  color: rgba(248,245,239,.62);
  font-size: 14px;
  line-height: 1.75;
}

.lbmOsVisualFooter {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  color: rgba(255,255,255,.35);
  font-size: 8px;
  letter-spacing: .18em;
}

.lbmOsPaintShape {
  position: absolute;
  z-index: 1;
  pointer-events: none;
  border-radius: 999px;
  filter: blur(.2px);
}

.lbmOsPaintShape.shapeOne {
  width: 420px;
  height: 170px;
  right: -150px;
  top: 18%;
  transform: rotate(-24deg);
  background: rgba(212,175,55,.08);
}

.lbmOsPaintShape.shapeTwo {
  width: 300px;
  height: 120px;
  left: -120px;
  bottom: 14%;
  transform: rotate(18deg);
  background: rgba(248,245,239,.05);
}

.lbmOsPaintShape.shapeThree {
  width: 180px;
  height: 180px;
  right: 12%;
  bottom: -90px;
  background: rgba(155,177,150,.09);
}

/* ---------------------------------------------------------
   LOGIN PANEL
   --------------------------------------------------------- */

.lbmOsLoginPanel {
  position: relative;
  min-height: 100vh;
  background: #f8f5ef;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lbmOsLoginPanelInner {
  width: min(100%, 520px);
  padding: 54px clamp(34px, 5vw, 78px);
}

.lbmOsSecureHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 82px;
  padding-bottom: 16px;
  border-bottom: 1px solid #ddd9d0;
}

.lbmOsSecureStatus {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #6d7280;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .18em;
}

.lbmOsSecureDot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #73886f;
  box-shadow: 0 0 0 4px rgba(115,136,111,.12);
}

.lbmOsSecureCode {
  color: #aaa59b;
  font-size: 8px;
  letter-spacing: .16em;
}

.lbmOsLoginHeader {
  margin-bottom: 42px;
}

.lbmOsLoginHeader .lbmOsEyebrow {
  margin-bottom: 18px;
}

.lbmOsLoginHeader h1 {
  margin: 0 0 20px;
  color: #202634;
  font-size: clamp(54px, 6vw, 78px);
  line-height: .9;
  letter-spacing: -.065em;
  font-weight: 500;
}

.lbmOsLoginHeader h1 span {
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
  font-weight: 400;
  color: #a47c12;
}

.lbmOsLoginHeader > p:last-child {
  max-width: 390px;
  margin: 0;
  color: #777b84;
  font-size: 14px;
  line-height: 1.7;
}

/* ---------------------------------------------------------
   FORM
   --------------------------------------------------------- */

.lbmOsLoginForm {
  display: grid;
  gap: 24px;
}

.lbmOsField {
  display: grid;
  gap: 9px;
}

.lbmOsField label,
.lbmOsPasswordLabel label {
  color: #343945;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.lbmOsInputWrap {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 58px;
  border: 1px solid #d6d2ca;
  background: rgba(255,255,255,.48);
  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.lbmOsInputWrap:focus-within {
  border-color: #b18a25;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(212,175,55,.09);
}

.lbmOsInputIcon {
  width: 48px;
  flex: 0 0 48px;
  color: #a9a49a;
  text-align: center;
  font-size: 12px;
  letter-spacing: -.08em;
}

.lbmOsInputWrap input {
  min-width: 0;
  flex: 1;
  height: 56px;
  padding: 0 14px 0 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #202634;
  font: inherit;
  font-size: 14px;
}

.lbmOsInputWrap input::placeholder {
  color: #aaa69e;
}

.lbmOsPasswordLabel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.lbmOsForgotButton,
.lbmOsPasswordToggle {
  border: 0;
  background: transparent;
  color: #9b7620;
  cursor: pointer;
  font: inherit;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .06em;
}

.lbmOsForgotButton:hover,
.lbmOsPasswordToggle:hover {
  color: #202634;
}

.lbmOsForgotButton:disabled,
.lbmOsPasswordToggle:disabled {
  cursor: wait;
  opacity: .5;
}

.lbmOsPasswordToggle {
  min-width: 58px;
  min-height: 44px;
  margin-right: 4px;
}

.lbmOsLoginForm .lbmOsLoginError,
.lbmOsLoginForm .lbmOsLoginSuccess {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 13px 14px;
  font-size: 12px;
  line-height: 1.5;
}

.lbmOsLoginError {
  border: 1px solid rgba(156,67,67,.18);
  background: #faf0ee;
  color: #8b4545;
}

.lbmOsLoginSuccess {
  border: 1px solid rgba(115,136,111,.22);
  background: #edf2ea;
  color: #53664f;
}

.lbmOsLoginError span,
.lbmOsLoginSuccess span {
  flex: 0 0 auto;
  font-weight: 800;
}

.lbmOsSignInButton {
  width: 100%;
  min-height: 58px;
  margin-top: 4px;
  padding: 0 22px;
  border: 1px solid #d4af37;
  position: relative;
  overflow: hidden;
  transition:
    transform .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}

.lbmOsSignInButton::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,.2);
  transform: translateX(-105%);
  transition: transform .45s ease;
}

.lbmOsSignInButton:hover {
  background: #e0bc4c;
  box-shadow: 0 12px 30px rgba(30,42,68,.12);
  transform: translateY(-1px);
}

.lbmOsSignInButton:hover::before {
  transform: translateX(105%);
}

.lbmOsSignInButton:active {
  transform: translateY(0);
}

.lbmOsSignInButton:disabled {
  cursor: wait;
  opacity: .7;
  transform: none;
}

.lbmOsSignInButton span {
  position: relative;
  z-index: 1;
}

.lbmOsButtonArrow {
  margin-left: auto;
  font-size: 20px;
  line-height: 1;
  font-weight: 400;
}

.lbmOsLoginMeta {
  margin-top: 54px;
  padding-top: 20px;
  border-top: 1px solid #ddd9d0;
}

.lbmOsLoginMeta > div {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #9b968d;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .16em;
}

.lbmOsMetaLine {
  width: 18px;
  height: 1px;
  background: #d4af37;
}

.lbmOsLoginMeta p {
  margin: 10px 0 0;
  color: #aaa59b;
  font-size: 10px;
  line-height: 1.6;
}

/* ---------------------------------------------------------
   ACCESSIBILITY
   --------------------------------------------------------- */

.lbmOsLoginPage button:focus-visible,
.lbmOsLoginPage input:focus-visible {
  outline: 2px solid #a47c12;
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .lbmOsLoginPage *,
  .lbmOsLoginPage *::before,
  .lbmOsLoginPage *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ---------------------------------------------------------
   RESET PASSWORD COMPATIBILITY
   --------------------------------------------------------- */

.lbmOsLoginPage .lbmOsLoginCard {
  width: min(100% - 40px, 520px);
  margin: auto;
  padding: 52px;
  background: #f8f5ef;
  border: 1px solid #ddd9d0;
}

.lbmOsLoginPage .lbmOsLoginCard .lbmOsBrand {
  padding: 0;
  margin-bottom: 50px;
}

.lbmOsLoginPage .lbmOsLoginCard .lbmOsLoginHeader h1 {
  color: #202634;
  font-size: clamp(42px, 7vw, 62px);
  line-height: .92;
  letter-spacing: -.055em;
}

.lbmOsLoginPage .lbmOsLoginCard .lbmOsLoginHeader p {
  color: #777b84;
}

.lbmOsLoginPage .lbmOsLoginCard .lbmOsLoginForm {
  margin-top: 35px;
}

.lbmOsLoginPage .lbmOsLoginCard input {
  width: 100%;
  min-height: 52px;
  padding: 0 14px;
  border: 1px solid #d0ccc4;
  background: #fff;
  color: #202634;
  font: inherit;
}

.lbmOsLoginPage .lbmOsLoginCard input:focus {
  outline: 2px solid rgba(212,175,55,.28);
  border-color: #b18a25;
}

.lbmOsLoginPage .lbmOsLoginCard label {
  display: block;
  margin-bottom: 8px;
  color: #343945;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.lbmOsLoginPage .lbmOsLoginCard .lbmOsButton {
  width: 100%;
}

/* ---------------------------------------------------------
   RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 1050px) {
  .lbmOsLoginShell {
    grid-template-columns: minmax(0, .92fr) minmax(400px, 1.08fr);
  }

  .lbmOsLoginVisual {
    padding-left: 42px;
    padding-right: 42px;
  }

  .lbmOsVisualContent h2 {
    font-size: clamp(54px, 7vw, 82px);
  }

  .lbmOsLoginPanelInner {
    padding-left: 42px;
    padding-right: 42px;
  }
}

@media (max-width: 820px) {
  .lbmOsLoginShell {
    display: block;
  }

  .lbmOsLoginVisual {
    min-height: 300px;
    height: 300px;
    padding: 28px 28px 25px;
  }

  .lbmOsVisualContent {
    padding: 20px 0;
  }

  .lbmOsVisualContent h2 {
    font-size: clamp(48px, 11vw, 72px);
  }

  .lbmOsVisualContent p,
  .lbmOsPaintLine {
    display: none;
  }

  .lbmOsVisualFooter {
    display: none;
  }

  .lbmOsLoginPanel {
    min-height: calc(100svh - 300px);
    align-items: flex-start;
  }

  .lbmOsLoginPanelInner {
    width: min(100%, 600px);
    margin: 0 auto;
    padding: 42px 28px 60px;
  }

  .lbmOsSecureHeader {
    margin-bottom: 55px;
  }
}

@media (max-width: 520px) {
  .lbmOsLoginVisual {
    min-height: 235px;
    height: 235px;
    padding: 22px 20px;
  }

  .lbmOsLoginVisual .lbmOsBrandMark {
    width: 38px;
    height: 38px;
  }

  .lbmOsLoginVisual .lbmOsBrand strong,
  .lbmOsLoginVisual .lbmOsBrand span {
    font-size: 8px;
  }

  .lbmOsVersion {
    font-size: 7px;
  }

  .lbmOsVisualContent {
    padding: 10px 0 0;
  }

  .lbmOsVisualEyebrow {
    margin-bottom: 17px;
    font-size: 8px;
  }

  .lbmOsVisualContent h2 {
    font-size: clamp(44px, 14vw, 62px);
  }

  .lbmOsLoginPanel {
    min-height: calc(100svh - 235px);
  }

  .lbmOsLoginPanelInner {
    padding: 30px 20px 45px;
  }

  .lbmOsSecureHeader {
    margin-bottom: 45px;
  }

  .lbmOsLoginHeader {
    margin-bottom: 32px;
  }

  .lbmOsLoginHeader h1 {
    font-size: 54px;
  }

  .lbmOsLoginHeader > p:last-child {
    font-size: 13px;
  }

  .lbmOsInputWrap {
    min-height: 56px;
  }

  .lbmOsInputWrap input {
    height: 54px;
  }

  .lbmOsLoginMeta {
    margin-top: 42px;
  }

  .lbmOsLoginPage .lbmOsLoginCard {
    width: min(100% - 24px, 520px);
    padding: 30px 22px;
  }
}

/* =========================================================
   LITTLE BRUSH MASTERS
   PREMIUM LOGIN EXPERIENCE
   ========================================================= */

.lbmPremiumLogin {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  background: #f8f5ef;
  color: #202634;
}


/* =========================================================
   LEFT BRAND EXPERIENCE
   ========================================================= */

.lbmPremiumHero {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 72% 25%,
      rgba(212,175,55,.12),
      transparent 25%
    ),
    #1e2a44;
  color: #fff;
  padding: 38px 5vw 34px;
  display: flex;
  flex-direction: column;
}

.lbmPremiumNoise {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .045;
  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
}

.lbmPremiumHeroTop,
.lbmPremiumHeroContent,
.lbmPremiumHeroBottom {
  position: relative;
  z-index: 3;
}

.lbmPremiumHeroTop {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.lbmPremiumLogo {
  display: flex;
  align-items: center;
  gap: 13px;
}

.lbmPremiumLogoMark {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.35);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
}

.lbmPremiumLogoText strong,
.lbmPremiumLogoText span {
  display: block;
  font-size: 10px;
  letter-spacing: .18em;
}

.lbmPremiumLogoText span {
  margin-top: 4px;
  opacity: .55;
}

.lbmPremiumEdition {
  text-align: right;
  color: rgba(255,255,255,.42);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .18em;
  line-height: 1.6;
}

.lbmPremiumHeroContent {
  margin-top: auto;
  margin-bottom: auto;
  max-width: 650px;
}

.lbmPremiumKicker {
  margin: 0 0 25px;
  color: #d4af37;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .2em;
}

.lbmPremiumHeroContent h1 {
  margin: 0;
  font-size: clamp(55px, 6.5vw, 105px);
  line-height: .88;
  letter-spacing: -.07em;
  font-weight: 500;
}

.lbmPremiumHeroContent h1 em {
  color: #d4af37;
  font-family: Georgia, serif;
  font-weight: 400;
}

.lbmPremiumRule {
  width: 80px;
  height: 1px;
  margin: 38px 0 24px;
  background: #d4af37;
}

.lbmPremiumHeroDescription {
  max-width: 400px;
  margin: 0;
  color: rgba(255,255,255,.57);
  font-size: 13px;
  line-height: 1.8;
}

.lbmPremiumHeroBottom {
  display: flex;
  justify-content: space-between;
  padding-top: 25px;
  border-top: 1px solid rgba(255,255,255,.12);
  color: rgba(255,255,255,.35);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .15em;
}


/* =========================================================
   PAINT ELEMENTS
   ========================================================= */

.lbmPaintBlob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  opacity: .16;
}

.lbmPaintBlobOne {
  width: 260px;
  height: 170px;
  right: -80px;
  top: 18%;
  background: #d4af37;
  transform: rotate(-18deg);
  border-radius: 48% 52% 65% 35%;
}

.lbmPaintBlobTwo {
  width: 190px;
  height: 270px;
  left: -90px;
  bottom: 12%;
  background: #8ba18a;
  transform: rotate(22deg);
  border-radius: 60% 40% 35% 65%;
}

.lbmPaintBlobThree {
  width: 95px;
  height: 95px;
  right: 18%;
  bottom: 24%;
  background: #d4af37;
  opacity: .1;
}

.lbmPaintStroke {
  position: absolute;
  right: 6%;
  top: 43%;
  display: flex;
  gap: 5px;
  transform: rotate(-25deg);
  opacity: .14;
}

.lbmPaintStroke span {
  display: block;
  width: 5px;
  height: 95px;
  border-radius: 10px;
  background: #fff;
}

.lbmPaintStroke span:nth-child(2) {
  height: 120px;
}

.lbmPaintStroke span:nth-child(3) {
  height: 82px;
}

.lbmPaintStroke span:nth-child(4) {
  height: 110px;
}


/* =========================================================
   LOGIN PANEL
   ========================================================= */

.lbmPremiumLoginPanel {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 45px 6vw;
  background: #f8f5ef;
}

.lbmPremiumLoginInner {
  width: 100%;
  max-width: 500px;
}

.lbmPremiumSecure {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 48px;
  color: #8b8c8d;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .17em;
}

.lbmSecureIndicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #75896d;
  box-shadow: 0 0 0 4px rgba(117,137,109,.12);
}

.lbmSecureDivider {
  color: #d1cec6;
}

.lbmPremiumLoginHeader {
  margin-bottom: 42px;
}

.lbmPremiumLoginHeader > p:first-child {
  margin: 0 0 17px;
  color: #a47c12;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .2em;
}

.lbmPremiumLoginHeader h2 {
  margin: 0;
  font-size: clamp(45px, 5vw, 68px);
  line-height: .9;
  letter-spacing: -.065em;
  font-weight: 500;
}

.lbmPremiumLoginHeader h2 span {
  color: #8d8e91;
}

.lbmPremiumHeaderLine {
  width: 55px;
  height: 1px;
  margin: 27px 0 18px;
  background: #d4af37;
}

.lbmPremiumLoginHeader > span {
  display: block;
  max-width: 350px;
  color: #777a80;
  font-size: 13px;
  line-height: 1.7;
}


/* =========================================================
   FORM
   ========================================================= */

.lbmPremiumForm {
  display: grid;
  gap: 25px;
}

.lbmPremiumField {
  display: grid;
  gap: 9px;
}

.lbmPremiumField label,
.lbmPremiumLabelRow label {
  color: #555962;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .15em;
}

.lbmPremiumLabelRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lbmPremiumInput {
  position: relative;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #c9c6be;
  transition: border-color .2s ease;
}

.lbmPremiumInput:focus-within {
  border-color: #d4af37;
}

.lbmInputSymbol {
  width: 30px;
  color: #b0aca3;
  font-size: 10px;
  font-weight: 700;
}

.lbmPremiumInput input {
  width: 100%;
  min-height: 52px;
  border: 0;
  outline: 0;
  background: transparent;
  color: #202634;
  font: inherit;
  font-size: 14px;
}

.lbmPremiumInput input::placeholder {
  color: #aaa8a2;
}

.lbmPremiumForgot,
.lbmPremiumShow {
  border: 0;
  padding: 0;
  background: transparent;
  cursor: pointer;
  color: #a47c12;
  font: inherit;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .1em;
}

.lbmPremiumForgot:hover,
.lbmPremiumShow:hover {
  color: #7d5e0d;
}

.lbmPremiumForgot:disabled,
.lbmPremiumShow:disabled {
  opacity: .5;
  cursor: default;
}


/* =========================================================
   MESSAGES
   ========================================================= */

.lbmPremiumMessage {
  display: flex;
  gap: 12px;
  padding: 14px 15px;
  font-size: 11px;
  line-height: 1.5;
}

.lbmPremiumMessage p {
  margin: 0;
}

.lbmPremiumMessage.error {
  border-left: 2px solid #9b5c55;
  background: #f5eae8;
  color: #744741;
}

.lbmPremiumMessage.success {
  border-left: 2px solid #75896d;
  background: #e9eee6;
  color: #52634c;
}


/* =========================================================
   PRIMARY CTA
   ========================================================= */

.lbmPremiumLoginButton {
  position: relative;
  width: 100%;
  min-height: 58px;
  margin-top: 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px 0 22px;
  border: 1px solid #d4af37;
  background: #d4af37;
  color: #171717;
  cursor: pointer;
  font: inherit;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .13em;
  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}

.lbmPremiumLoginButton:hover:not(:disabled) {
  background: #1e2a44;
  color: #fff;
  transform: translateY(-1px);
}

.lbmPremiumLoginButton:disabled {
  opacity: .65;
  cursor: wait;
}

.lbmPremiumArrow {
  font-size: 19px;
  font-weight: 400;
}


/* =========================================================
   FOOTER
   ========================================================= */

.lbmPremiumLoginFooter {
  margin-top: 48px;
}

.lbmFooterLine {
  height: 1px;
  margin-bottom: 17px;
  background: #ddd9d0;
}

.lbmFooterSecurity {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: #92928f;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .13em;
}

.lbmPremiumLoginFooter p {
  max-width: 430px;
  margin: 15px 0 0;
  color: #aaa9a4;
  font-size: 10px;
  line-height: 1.7;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 950px) {
  .lbmPremiumLogin {
    grid-template-columns: 1fr;
  }

  .lbmPremiumHero {
    min-height: 430px;
  }

  .lbmPremiumHeroContent {
    margin-top: 80px;
    margin-bottom: 60px;
  }

  .lbmPremiumHeroContent h1 {
    font-size: clamp(48px, 10vw, 78px);
  }

  .lbmPremiumLoginPanel {
    min-height: auto;
    padding: 70px 7vw 80px;
  }
}

@media (max-width: 600px) {
  .lbmPremiumHero {
    min-height: 390px;
    padding: 27px 24px 25px;
  }

  .lbmPremiumEdition {
    display: none;
  }

  .lbmPremiumHeroContent {
    margin-top: 60px;
  }

  .lbmPremiumHeroContent h1 {
    font-size: 51px;
  }

  .lbmPremiumHeroDescription {
    font-size: 12px;
  }

  .lbmPremiumLoginPanel {
    padding: 55px 24px 65px;
  }

  .lbmPremiumSecure {
    margin-bottom: 38px;
  }

  .lbmPremiumLoginHeader {
    margin-bottom: 35px;
  }

  .lbmPremiumLoginHeader h2 {
    font-size: 47px;
  }

  .lbmPremiumHeroBottom {
    font-size: 7px;
  }

  .lbmFooterSecurity {
    flex-direction: column;
  }
}
"use client";

import {
  FormEvent,
  useMemo,
  useState,
} from "react";
import {
  useRouter,
  useSearchParams,
} from "next/navigation";
import { createClient } from "../../../lib/supabase/client";

export default function LoginForm() {
  const router = useRouter();
  const searchParams = useSearchParams();

  const [email, setEmail] = useState(
    "littlebrushmasters@gmail.com"
  );
  const [password, setPassword] = useState("");

  const [showPassword, setShowPassword] =
    useState(false);

  const [loading, setLoading] = useState(false);
  const [resetLoading, setResetLoading] =
    useState(false);

  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  const passwordStrength = useMemo(() => {
    if (!password) return 0;

    let score = 0;

    if (password.length >= 8) score++;
    if (password.length >= 12) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;

    return Math.min(score, 4);
  }, [password]);

  async function handleSubmit(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    setLoading(true);
    setError("");
    setMessage("");

    const supabase = createClient();

    const { error: signInError } =
      await supabase.auth.signInWithPassword({
        email: email.trim(),
        password,
      });

    if (signInError) {
      setError(signInError.message);
      setLoading(false);
      return;
    }

    const next =
      searchParams.get("next") || "/os";

    router.replace(next);
    router.refresh();
  }

  async function handleForgotPassword() {
    setError("");
    setMessage("");

    const trimmedEmail = email.trim();

    if (!trimmedEmail) {
      setError(
        "Enter your email address first."
      );
      return;
    }

    setResetLoading(true);

    const supabase = createClient();

    const { error: resetError } =
      await supabase.auth.resetPasswordForEmail(
        trimmedEmail,
        {
          redirectTo:
            `${window.location.origin}/os/reset-password`,
        }
      );

    if (resetError) {
      setError(resetError.message);
      setResetLoading(false);
      return;
    }

    setMessage(
      "Reset instructions have been sent to your email."
    );

    setResetLoading(false);
  }

  return (
    <main className="lbmLogin">

      {/* Ambient animated background */}

      <div className="lbmLoginAmbient">
        <div className="lbmOrb lbmOrbOne" />
        <div className="lbmOrb lbmOrbTwo" />
        <div className="lbmOrb lbmOrbThree" />

        <div className="lbmPaintRing lbmPaintRingOne" />
        <div className="lbmPaintRing lbmPaintRingTwo" />

        <div className="lbmFloatingDot lbmDotOne" />
        <div className="lbmFloatingDot lbmDotTwo" />
        <div className="lbmFloatingDot lbmDotThree" />
        <div className="lbmFloatingDot lbmDotFour" />
      </div>


      {/* Brand */}

      <header className="lbmLoginBrand">

        <div className="lbmLoginLogo">
          LB
        </div>

        <div>
          <strong>
            LITTLE BRUSH
          </strong>

          <span>
            MASTERS
          </span>
        </div>

      </header>


      {/* Centred authentication experience */}

      <section className="lbmLoginStage">

        <div className="lbmLoginCard">

          {/* animated top accent */}

          <div className="lbmCardAccent">
            <span />
            <span />
            <span />
          </div>


          {/* Card header */}

          <div className="lbmLoginHeader">

            <div className="lbmSecureBadge">

              <span className="lbmPulseDot" />

              PRIVATE ACCESS

            </div>

            <h1>
              Welcome
              <br />
              <em>back.</em>
            </h1>

            <p>
              Enter your credentials to access
              the Little Brush Masters Command
              Centre.
            </p>

          </div>


          <form
            onSubmit={handleSubmit}
            className="lbmLoginForm"
          >

            {/* Email */}

            <div className="lbmField">

              <label htmlFor="email">
                EMAIL ADDRESS
              </label>

              <div className="lbmInputWrap">

                <div className="lbmInputIcon">
                  @
                </div>

                <input
                  id="email"
                  name="email"
                  type="email"
                  autoComplete="email"
                  value={email}
                  onChange={(event) => {
                    setEmail(
                      event.target.value
                    );
                    setError("");
                  }}
                  required
                  disabled={loading}
                />

                <div className="lbmInputGlow" />

              </div>

            </div>


            {/* Password */}

            <div className="lbmField">

              <div className="lbmFieldHeader">

                <label htmlFor="password">
                  PASSWORD
                </label>

                <button
                  type="button"
                  className="lbmForgot"
                  onClick={
                    handleForgotPassword
                  }
                  disabled={
                    resetLoading ||
                    loading
                  }
                >
                  {resetLoading
                    ? "SENDING..."
                    : "FORGOT PASSWORD?"}
                </button>

              </div>

              <div className="lbmInputWrap">

                <div className="lbmInputIcon">
                  •••
                </div>

                <input
                  id="password"
                  name="password"
                  type={
                    showPassword
                      ? "text"
                      : "password"
                  }
                  autoComplete="current-password"
                  value={password}
                  onChange={(event) => {
                    setPassword(
                      event.target.value
                    );
                    setError("");
                  }}
                  required
                  disabled={loading}
                />

                <button
                  type="button"
                  className="lbmPasswordToggle"
                  onClick={() =>
                    setShowPassword(
                      (value) => !value
                    )
                  }
                  aria-label={
                    showPassword
                      ? "Hide password"
                      : "Show password"
                  }
                >
                  {showPassword
                    ? "HIDE"
                    : "SHOW"}
                </button>

                <div className="lbmInputGlow" />

              </div>


              {/* Password intelligence */}

              {password && (
                <div className="lbmPasswordMeter">

                  <div className="lbmPasswordBars">

                    {[1, 2, 3, 4].map(
                      (bar) => (
                        <span
                          key={bar}
                          className={
                            passwordStrength >= bar
                              ? "active"
                              : ""
                          }
                        />
                      )
                    )}

                  </div>

                  <small>
                    {passwordStrength <= 1
                      ? "Weak"
                      : passwordStrength === 2
                      ? "Fair"
                      : passwordStrength === 3
                      ? "Strong"
                      : "Very strong"}
                  </small>

                </div>
              )}

            </div>


            {/* Feedback */}

            {error && (
              <div
                className="lbmFeedback lbmFeedbackError"
                role="alert"
              >
                <span>!</span>
                <p>{error}</p>
              </div>
            )}

            {message && (
              <div
                className="lbmFeedback lbmFeedbackSuccess"
                role="status"
              >
                <span>✓</span>
                <p>{message}</p>
              </div>
            )}


            {/* Animated CTA */}

            <button
              type="submit"
              className="lbmEnterButton"
              disabled={loading}
            >

              <span className="lbmButtonShimmer" />

              <span className="lbmButtonText">

                {loading
                  ? "AUTHENTICATING..."
                  : "ENTER COMMAND CENTRE"}

              </span>

              <span className="lbmButtonArrow">
                {loading ? (
                  <span className="lbmSpinner" />
                ) : (
                  "→"
                )}
              </span>

            </button>

          </form>


          {/* Footer */}

          <div className="lbmLoginFooter">

            <div className="lbmFooterTop">

              <span>
                LBMOS
              </span>

              <span className="lbmFooterLine" />

              <span>
                SECURE
              </span>

            </div>

            <p>
              A private operating environment
              for Little Brush Masters.
            </p>

          </div>

        </div>


        {/* Floating brand statement */}

        <div className="lbmSideStatement">

          <span>
            THE CHILDHOOD PROJECT
          </span>

          <div />

          <p>
            Creating memories
            <br />
            worth remembering.
          </p>

        </div>

      </section>


      {/* Bottom metadata */}

      <footer className="lbmLoginBottom">

        <span>
          LITTLE BRUSH MASTERS
        </span>

        <span>
          CAPE TOWN · SOUTH AFRICA
        </span>

        <span>
          EST. 2025
        </span>

      </footer>

    </main>
  );
}/* ============================================================
   LITTLE BRUSH MASTERS — PREMIUM AUTH EXPERIENCE
   ============================================================ */

.lbmLogin {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(212, 175, 55, .08),
      transparent 30%
    ),
    #f8f5ef;

  color: #202634;
}


/* ============================================================
   AMBIENT BACKGROUND
   ============================================================ */

.lbmLoginAmbient {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.lbmOrb {
  position: absolute;
  border-radius: 50%;
  filter: blur(1px);
  opacity: .45;
  animation:
    lbmFloat 12s ease-in-out infinite;
}

.lbmOrbOne {
  width: 380px;
  height: 380px;
  left: -180px;
  top: -120px;

  background:
    radial-gradient(
      circle,
      rgba(212, 175, 55, .16),
      transparent 68%
    );
}

.lbmOrbTwo {
  width: 430px;
  height: 430px;
  right: -210px;
  bottom: -180px;

  background:
    radial-gradient(
      circle,
      rgba(30, 42, 68, .11),
      transparent 68%
    );

  animation-delay: -4s;
}

.lbmOrbThree {
  width: 220px;
  height: 220px;
  right: 10%;
  top: 8%;

  background:
    radial-gradient(
      circle,
      rgba(139, 161, 138, .10),
      transparent 68%
    );

  animation-delay: -8s;
}


/* ============================================================
   PAINT RINGS
   ============================================================ */

.lbmPaintRing {
  position: absolute;
  width: 320px;
  height: 320px;

  border: 1px solid rgba(212, 175, 55, .13);
  border-radius: 43% 57% 52% 48%;

  animation:
    lbmRotate 30s linear infinite;
}

.lbmPaintRingOne {
  left: 7%;
  top: 25%;
}

.lbmPaintRingTwo {
  right: 7%;
  bottom: 18%;
  width: 230px;
  height: 230px;
  animation-direction: reverse;
  animation-duration: 24s;
}


/* ============================================================
   FLOATING DOTS
   ============================================================ */

.lbmFloatingDot {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #d4af37;
  opacity: .5;

  animation:
    lbmDotFloat 7s ease-in-out infinite;
}

.lbmDotOne {
  left: 19%;
  top: 18%;
}

.lbmDotTwo {
  left: 12%;
  bottom: 25%;
  animation-delay: -2s;
}

.lbmDotThree {
  right: 18%;
  top: 24%;
  animation-delay: -4s;
}

.lbmDotFour {
  right: 12%;
  bottom: 20%;
  animation-delay: -6s;
}


/* ============================================================
   BRAND
   ============================================================ */

.lbmLoginBrand {
  position: absolute;
  top: 35px;
  left: 42px;

  display: flex;
  align-items: center;
  gap: 12px;

  z-index: 5;
}

.lbmLoginLogo {
  width: 43px;
  height: 43px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(30, 42, 68, .25);

  color: #1e2a44;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
}

.lbmLoginBrand strong,
.lbmLoginBrand span {
  display: block;

  font-size: 9px;
  letter-spacing: .17em;
}

.lbmLoginBrand strong {
  color: #1e2a44;
}

.lbmLoginBrand span {
  margin-top: 4px;
  color: #98968f;
}


/* ============================================================
   CENTRED LOGIN STAGE
   ============================================================ */

.lbmLoginStage {
  position: relative;
  z-index: 4;

  width: 100%;

  display: flex;
  justify-content: center;
  align-items: center;

  padding: 110px 30px 100px;
}


/* ============================================================
   LOGIN CARD
   ============================================================ */

.lbmLoginCard {
  position: relative;

  width: min(100%, 470px);

  padding: 46px 46px 38px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.94),
      rgba(255,255,255,.78)
    );

  border: 1px solid rgba(30, 42, 68, .10);

  box-shadow:
    0 35px 100px rgba(30,42,68,.12),
    0 8px 30px rgba(30,42,68,.06);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  animation:
    lbmCardIn .8s cubic-bezier(.16,1,.3,1)
    both;
}


/* subtle card glow */

.lbmLoginCard::before {
  content: "";

  position: absolute;
  inset: -1px;

  border-radius: inherit;

  background:
    linear-gradient(
      135deg,
      rgba(212,175,55,.24),
      transparent 35%,
      transparent 65%,
      rgba(30,42,68,.08)
    );

  opacity: .35;

  pointer-events: none;

  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);

  mask-composite: exclude;
  padding: 1px;
}


/* ============================================================
   ANIMATED CARD ACCENT
   ============================================================ */

.lbmCardAccent {
  position: absolute;
  top: 0;
  left: 46px;

  display: flex;
  gap: 5px;

  height: 3px;
}

.lbmCardAccent span {
  display: block;
  height: 3px;

  background: #d4af37;

  animation:
    lbmAccentGrow .8s cubic-bezier(.16,1,.3,1)
    both;
}

.lbmCardAccent span:nth-child(1) {
  width: 48px;
}

.lbmCardAccent span:nth-child(2) {
  width: 14px;
  animation-delay: .1s;
}

.lbmCardAccent span:nth-child(3) {
  width: 7px;
  animation-delay: .2s;
}


/* ============================================================
   HEADER
   ============================================================ */

.lbmLoginHeader {
  margin-bottom: 38px;
}

.lbmSecureBadge {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 22px;

  color: #9a771c;

  font-size: 8px;
  font-weight: 800;
  letter-spacing: .17em;
}

.lbmPulseDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #75896d;

  box-shadow:
    0 0 0 0 rgba(117,137,109,.45);

  animation:
    lbmPulse 2s infinite;
}

.lbmLoginHeader h1 {
  margin: 0;

  font-size: clamp(48px, 6vw, 66px);
  line-height: .88;

  font-weight: 500;

  letter-spacing: -.065em;
}

.lbmLoginHeader h1 em {
  color: #a47c12;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-weight: 400;
}

.lbmLoginHeader p {
  max-width: 330px;

  margin: 24px 0 0;

  color: #777b83;

  font-size: 12px;
  line-height: 1.75;
}


/* ============================================================
   FORM
   ============================================================ */

.lbmLoginForm {
  display: grid;
  gap: 25px;
}

.lbmField {
  display: grid;
  gap: 9px;
}

.lbmField > label,
.lbmFieldHeader label {
  color: #60636a;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: .17em;
}

.lbmFieldHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lbmForgot {
  border: 0;
  padding: 0;

  background: transparent;

  color: #a47c12;

  cursor: pointer;

  font: inherit;

  font-size: 8px;
  font-weight: 800;
  letter-spacing: .08em;
}

.lbmForgot:hover {
  color: #76590c;
}

.lbmForgot:disabled {
  opacity: .45;
  cursor: default;
}


/* ============================================================
   INPUTS
   ============================================================ */

.lbmInputWrap {
  position: relative;

  display: flex;
  align-items: center;

  min-height: 55px;

  border-bottom: 1px solid #cfccc4;

  transition:
    border-color .25s ease,
    transform .25s ease;
}

.lbmInputWrap:focus-within {
  border-color: #d4af37;
  transform: translateY(-1px);
}

.lbmInputIcon {
  width: 32px;

  color: #b1aea7;

  font-size: 10px;
  font-weight: 700;

  transition:
    color .25s ease,
    transform .25s ease;
}

.lbmInputWrap:focus-within
.lbmInputIcon {
  color: #d4af37;
  transform: scale(1.08);
}

.lbmInputWrap input {
  position: relative;
  z-index: 2;

  width: 100%;
  height: 54px;

  padding: 0;

  border: 0;
  outline: 0;

  background: transparent;

  color: #202634;

  font: inherit;
  font-size: 14px;
}

.lbmInputWrap input:disabled {
  opacity: .65;
}

.lbmInputGlow {
  position: absolute;
  left: 32px;
  right: 0;
  bottom: -1px;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      #d4af37,
      #ead58b,
      transparent
    );

  transform:
    scaleX(0);

  transform-origin: left;

  transition:
    transform .35s ease;
}

.lbmInputWrap:focus-within
.lbmInputGlow {
  transform: scaleX(1);
}

.lbmPasswordToggle {
  position: relative;
  z-index: 3;

  border: 0;
  padding: 6px;

  background: transparent;

  color: #a2a19c;

  cursor: pointer;

  font-size: 8px;
  font-weight: 800;
  letter-spacing: .08em;
}

.lbmPasswordToggle:hover {
  color: #1e2a44;
}


/* ============================================================
   PASSWORD METER
   ============================================================ */

.lbmPasswordMeter {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: -2px;
}

.lbmPasswordBars {
  display: flex;
  gap: 4px;
  width: 90px;
}

.lbmPasswordBars span {
  flex: 1;
  height: 2px;

  background: #ddd9d0;

  transition:
    background .25s ease,
    transform .25s ease;
}

.lbmPasswordBars span.active {
  background: #d4af37;
  transform: scaleY(1.8);
}

.lbmPasswordMeter small {
  color: #999993;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .08em;
}


/* ============================================================
   FEEDBACK
   ============================================================ */

.lbmFeedback {
  display: flex;
  align-items: flex-start;
  gap: 10px;

  padding: 13px 14px;

  font-size: 11px;
  line-height: 1.5;

  animation:
    lbmMessageIn .3s ease both;
}

.lbmFeedback p {
  margin: 0;
}

.lbmFeedback > span {
  display: grid;
  place-items: center;

  width: 17px;
  height: 17px;

  flex: 0 0 17px;

  border-radius: 50%;

  font-size: 9px;
  font-weight: 800;
}

.lbmFeedbackError {
  background: #f7eae8;
  color: #794842;
}

.lbmFeedbackError > span {
  background: #9b5c55;
  color: white;
}

.lbmFeedbackSuccess {
  background: #eaf0e7;
  color: #52664d;
}

.lbmFeedbackSuccess > span {
  background: #75896d;
  color: white;
}


/* ============================================================
   ENTER BUTTON
   ============================================================ */

.lbmEnterButton {
  position: relative;

  overflow: hidden;

  width: 100%;
  min-height: 58px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 3px;

  padding: 0 19px 0 22px;

  border: 1px solid #d4af37;

  background: #d4af37;

  color: #171717;

  cursor: pointer;

  font: inherit;

  font-size: 9px;
  font-weight: 900;

  letter-spacing: .14em;

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    background .25s ease,
    color .25s ease;
}

.lbmEnterButton:hover:not(:disabled) {
  transform: translateY(-2px);

  background: #1e2a44;

  color: white;

  box-shadow:
    0 14px 30px rgba(30,42,68,.15);
}

.lbmEnterButton:active:not(:disabled) {
  transform: translateY(0);
}

.lbmEnterButton:disabled {
  opacity: .7;
  cursor: wait;
}

.lbmButtonText,
.lbmButtonArrow {
  position: relative;
  z-index: 2;
}

.lbmButtonArrow {
  font-size: 20px;
  font-weight: 400;

  transition:
    transform .25s ease;
}

.lbmEnterButton:hover
.lbmButtonArrow {
  transform: translateX(5px);
}


/* Button shimmer */

.lbmButtonShimmer {
  position: absolute;

  top: 0;
  left: -120%;

  width: 70%;
  height: 100%;

  transform: skewX(-20deg);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.32),
      transparent
    );

  animation:
    lbmShimmer 4s ease-in-out infinite;
}


/* Spinner */

.lbmSpinner {
  display: block;

  width: 16px;
  height: 16px;

  border: 2px solid rgba(255,255,255,.35);
  border-top-color: currentColor;

  border-radius: 50%;

  animation:
    lbmSpin .7s linear infinite;
}


/* ============================================================
   FOOTER
   ============================================================ */

.lbmLoginFooter {
  margin-top: 40px;
}

.lbmFooterTop {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #a3a19b;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .15em;
}

.lbmFooterLine {
  flex: 1;
  height: 1px;
  background: #dedbd3;
}

.lbmLoginFooter p {
  margin: 13px 0 0;

  color: #aaa8a1;

  font-size: 9px;
  line-height: 1.6;
}


/* ============================================================
   SIDE STATEMENT
   ============================================================ */

.lbmSideStatement {
  position: absolute;

  right: calc(50% + 270px);
  bottom: 115px;

  width: 150px;

  color: #a4a19a;

  animation:
    lbmFadeIn 1s .4s ease both;
}

.lbmSideStatement span {
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .14em;
}

.lbmSideStatement div {
  width: 30px;
  height: 1px;

  margin: 12px 0;

  background: #d4af37;
}

.lbmSideStatement p {
  margin: 0;

  font-family: Georgia, serif;

  font-size: 12px;
  line-height: 1.5;
}


/* ============================================================
   BOTTOM
   ============================================================ */

.lbmLoginBottom {
  position: absolute;

  left: 42px;
  right: 42px;
  bottom: 30px;

  z-index: 5;

  display: flex;
  justify-content: space-between;

  color: #aaa8a1;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .14em;
}


/* ============================================================
   ANIMATIONS
   ============================================================ */

@keyframes lbmCardIn {
  from {
    opacity: 0;
    transform:
      translateY(25px)
      scale(.97);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes lbmAccentGrow {
  from {
    transform: scaleX(0);
    transform-origin: left;
  }

  to {
    transform: scaleX(1);
    transform-origin: left;
  }
}

@keyframes lbmPulse {
  0%,
  100% {
    box-shadow:
      0 0 0 0 rgba(117,137,109,.4);
  }

  50% {
    box-shadow:
      0 0 0 5px rgba(117,137,109,0);
  }
}

@keyframes lbmFloat {
  0%,
  100% {
    transform: translate3d(0,0,0);
  }

  50% {
    transform: translate3d(12px,-18px,0);
  }
}

@keyframes lbmRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes lbmDotFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-18px);
  }
}

@keyframes lbmMessageIn {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes lbmShimmer {
  0% {
    left: -120%;
  }

  25%,
  100% {
    left: 150%;
  }
}

@keyframes lbmSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes lbmFadeIn {
  from {
    opacity: 0;
    transform: translateX(-10px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .lbmOrb,
  .lbmPaintRing,
  .lbmFloatingDot,
  .lbmPulseDot,
  .lbmLoginCard,
  .lbmCardAccent span,
  .lbmButtonShimmer,
  .lbmSpinner,
  .lbmSideStatement {
    animation: none;
  }
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 700px) {

  .lbmLogin {
    justify-content: center;
  }

  .lbmLoginBrand {
    top: 22px;
    left: 22px;
  }

  .lbmLoginStage {
    padding: 105px 20px 90px;
  }

  .lbmLoginCard {
    padding: 38px 28px 32px;
  }

  .lbmCardAccent {
    left: 28px;
  }

  .lbmLoginHeader h1 {
    font-size: 52px;
  }

  .lbmSideStatement {
    display: none;
  }

  .lbmLoginBottom {
    left: 22px;
    right: 22px;
    bottom: 18px;
  }

  .lbmLoginBottom span:nth-child(2) {
    display: none;
  }

  .lbmPaintRing {
    opacity: .5;
  }
}

/* =========================================================
   LBMOS PREMIUM GLASS LOGIN
   ========================================================= */

.lbmOsLoginPage {
  min-height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 40px 20px;

  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(212, 175, 55, 0.12),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 80%,
      rgba(96, 125, 170, 0.18),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #111a2d 0%,
      #1e2a44 48%,
      #121a2b 100%
    );

  color: #ffffff;
}


/* Subtle texture */

.lbmOsLoginPage::before {
  content: "";
  position: absolute;
  inset: 0;

  pointer-events: none;

  background-image:
    radial-gradient(
      rgba(255,255,255,.08) 1px,
      transparent 1px
    );

  background-size: 24px 24px;

  opacity: .12;
}


/* =========================================================
   AMBIENT BACKGROUND
   ========================================================= */

.lbmOsAmbient {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}


.lbmOsOrb {
  position: absolute;

  border-radius: 50%;

  filter: blur(70px);

  opacity: .45;

  animation:
    lbmOsOrbFloat 12s ease-in-out infinite alternate;
}


.lbmOsOrbOne {
  width: 420px;
  height: 420px;

  background: rgba(212,175,55,.20);

  top: -180px;
  left: -120px;
}


.lbmOsOrbTwo {
  width: 350px;
  height: 350px;

  background: rgba(108,145,200,.20);

  right: -100px;
  top: 30%;

  animation-delay: -4s;
}


.lbmOsOrbThree {
  width: 300px;
  height: 300px;

  background: rgba(212,175,55,.12);

  bottom: -140px;
  left: 30%;

  animation-delay: -7s;
}


@keyframes lbmOsOrbFloat {
  from {
    transform: translate3d(0,0,0) scale(1);
  }

  to {
    transform: translate3d(
      30px,
      -25px,
      0
    ) scale(1.08);
  }
}


/* =========================================================
   PAINT-LIKE ATMOSPHERIC STROKES
   ========================================================= */

.lbmOsPaintStroke {
  position: absolute;

  width: 500px;
  height: 100px;

  border-radius: 50%;

  border-top:
    1px solid
    rgba(212,175,55,.18);

  border-bottom:
    1px solid
    rgba(255,255,255,.06);

  transform: rotate(-24deg);

  filter: blur(.3px);

  opacity: .6;

  animation:
    lbmOsStrokeFloat 10s ease-in-out infinite alternate;
}


.lbmOsPaintStrokeOne {
  top: 20%;
  left: -180px;
}


.lbmOsPaintStrokeTwo {
  right: -190px;
  bottom: 20%;

  transform:
    rotate(24deg);

  animation-delay: -4s;
}


@keyframes lbmOsStrokeFloat {
  from {
    transform:
      translateX(0)
      rotate(-24deg);
  }

  to {
    transform:
      translateX(45px)
      rotate(-20deg);
  }
}


/* =========================================================
   BRAND
   ========================================================= */

.lbmOsLoginBrand {
  position: absolute;

  top: 42px;
  left: 50%;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 12px;

  z-index: 3;
}


.lbmOsLoginLogo {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border:
    1px solid
    rgba(255,255,255,.28);

  background:
    rgba(255,255,255,.07);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  box-shadow:
    0 8px 30px
    rgba(0,0,0,.18);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
}


.lbmOsLoginBrand strong,
.lbmOsLoginBrand span {
  display: block;

  font-size: 10px;
  letter-spacing: .18em;
}


.lbmOsLoginBrand span {
  margin-top: 3px;
  opacity: .55;
}


/* =========================================================
   GLASS CARD
   ========================================================= */

.lbmOsGlassCard {
  width: min(100%, 460px);

  position: relative;

  z-index: 2;

  padding: 1px;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.32),
      rgba(255,255,255,.07)
    );

  box-shadow:
    0 40px 100px
    rgba(0,0,0,.35),

    0 10px 35px
    rgba(0,0,0,.18);

  animation:
    lbmOsCardEnter .8s
    cubic-bezier(.22,1,.36,1);
}


@keyframes lbmOsCardEnter {
  from {
    opacity: 0;
    transform:
      translateY(25px)
      scale(.97);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}


.lbmOsGlassCard::before {
  content: "";

  position: absolute;
  inset: 0;

  border-radius: 28px;

  pointer-events: none;

  background:
    linear-gradient(
      120deg,
      rgba(255,255,255,.18),
      transparent 40%,
      transparent 70%,
      rgba(212,175,55,.08)
    );
}


.lbmOsLoginContent {
  position: relative;

  padding: 48px 42px 30px;

  border-radius: 27px;

  background:
    rgba(24,34,56,.72);

  backdrop-filter:
    blur(28px)
    saturate(130%);

  -webkit-backdrop-filter:
    blur(28px)
    saturate(130%);

  overflow: hidden;
}


.lbmOsGlassGlow {
  position: absolute;

  width: 200px;
  height: 200px;

  top: -100px;
  right: -70px;

  border-radius: 50%;

  background:
    rgba(212,175,55,.18);

  filter: blur(50px);

  pointer-events: none;
}


/* =========================================================
   HEADER
   ========================================================= */

.lbmOsLoginHeader {
  position: relative;
  z-index: 2;

  margin-bottom: 34px;
}


.lbmOsStatus {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 18px;

  color:
    rgba(255,255,255,.52);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: .18em;
}


.lbmOsStatusDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #d4af37;

  box-shadow:
    0 0 0 4px
    rgba(212,175,55,.10),

    0 0 15px
    rgba(212,175,55,.65);

  animation:
    lbmOsPulse 2s ease-in-out infinite;
}


@keyframes lbmOsPulse {
  0%,
  100% {
    opacity: .5;
    transform: scale(.85);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}


.lbmOsLoginHeader h1 {
  margin: 0;

  color: #ffffff;

  font-size:
    clamp(42px, 7vw, 58px);

  line-height: .95;

  letter-spacing: -.055em;

  font-weight: 600;
}


.lbmOsLoginHeader h1 span {
  display: block;

  color: #d4af37;
}


.lbmOsLoginHeader p {
  margin:
    18px 0 0;

  max-width: 340px;

  color:
    rgba(255,255,255,.56);

  font-size: 14px;

  line-height: 1.65;
}


/* =========================================================
   FORM
   ========================================================= */

.lbmOsLoginForm {
  position: relative;
  z-index: 2;

  display: grid;

  gap: 20px;
}


.lbmOsField {
  display: grid;
  gap: 8px;
}


.lbmOsField label,
.lbmOsPasswordLabel label {
  color:
    rgba(255,255,255,.70);

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .02em;
}


.lbmOsPasswordLabel {
  display: flex;
  align-items: center;
  justify-content: space-between;
}


.lbmOsForgotButton {
  padding: 0;

  border: 0;

  background: none;

  color:
    rgba(212,175,55,.85);

  cursor: pointer;

  font: inherit;

  font-size: 10px;

  font-weight: 700;

  transition:
    color .2s ease,
    opacity .2s ease;
}


.lbmOsForgotButton:hover {
  color: #ffffff;
}


.lbmOsForgotButton:disabled {
  opacity: .5;
  cursor: wait;
}


/* =========================================================
   GLASS INPUTS
   ========================================================= */

.lbmOsInputWrap {
  position: relative;

  display: flex;
  align-items: center;

  border:
    1px solid
    rgba(255,255,255,.12);

  border-radius: 14px;

  background:
    rgba(255,255,255,.055);

  box-shadow:
    inset 0 1px 0
    rgba(255,255,255,.04);

  transition:
    border-color .25s ease,
    background .25s ease,
    box-shadow .25s ease,
    transform .25s ease;
}


.lbmOsInputWrap:focus-within {
  border-color:
    rgba(212,175,55,.75);

  background:
    rgba(255,255,255,.085);

  box-shadow:
    0 0 0 4px
    rgba(212,175,55,.08),

    0 8px 30px
    rgba(0,0,0,.12);

  transform:
    translateY(-1px);
}


.lbmOsInputIcon {
  display: grid;
  place-items: center;

  width: 48px;

  color:
    rgba(255,255,255,.35);

  flex-shrink: 0;
}


.lbmOsInputWrap:focus-within
.lbmOsInputIcon {
  color: #d4af37;
}


.lbmOsInputWrap input {
  width: 100%;

  min-width: 0;

  height: 52px;

  padding:
    0 14px 0 0;

  border: 0;

  outline: 0;

  background: transparent;

  color: #ffffff;

  font: inherit;

  font-size: 13px;
}


.lbmOsInputWrap input::placeholder {
  color:
    rgba(255,255,255,.28);
}


.lbmOsPasswordToggle {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border: 0;

  background: transparent;

  color:
    rgba(255,255,255,.38);

  cursor: pointer;

  transition:
    color .2s ease,
    transform .2s ease;
}


.lbmOsPasswordToggle:hover {
  color: #ffffff;

  transform: scale(1.08);
}


/* =========================================================
   MESSAGES
   ========================================================= */

.lbmOsLoginMessage {
  display: flex;
  align-items: flex-start;
  gap: 10px;

  padding: 12px 14px;

  border-radius: 12px;

  font-size: 11px;

  line-height: 1.5;

  animation:
    lbmOsMessageIn .3s ease;
}


@keyframes lbmOsMessageIn {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


.lbmOsLoginMessage span {
  display: grid;
  place-items: center;

  width: 18px;
  height: 18px;

  flex-shrink: 0;

  border-radius: 50%;

  font-weight: 800;
}


.lbmOsLoginMessage.error {
  color: #ffd7d7;

  background:
    rgba(180,50,50,.14);

  border:
    1px solid
    rgba(255,120,120,.14);
}


.lbmOsLoginMessage.error span {
  background: rgba(255,100,100,.16);
}


.lbmOsLoginMessage.success {
  color: #e1f0df;

  background:
    rgba(100,150,90,.14);

  border:
    1px solid
    rgba(150,200,130,.14);
}


.lbmOsLoginMessage.success span {
  background:
    rgba(130,190,110,.18);
}


/* =========================================================
   ANIMATED GLASS BUTTON
   ========================================================= */

.lbmOsAnimatedButton {
  position: relative;

  height: 56px;

  margin-top: 4px;

  overflow: hidden;

  border:
    1px solid
    rgba(255,255,255,.22);

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #d4af37,
      #e4c766
    );

  color: #151515;

  cursor: pointer;

  font: inherit;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .02em;

  box-shadow:
    0 12px 30px
    rgba(0,0,0,.20),

    inset 0 1px 0
    rgba(255,255,255,.45);

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}


.lbmOsAnimatedButton:hover:not(:disabled) {
  transform:
    translateY(-2px);

  box-shadow:
    0 18px 38px
    rgba(0,0,0,.28),

    0 0 30px
    rgba(212,175,55,.15),

    inset 0 1px 0
    rgba(255,255,255,.5);
}


.lbmOsAnimatedButton:active:not(:disabled) {
  transform:
    translateY(0)
    scale(.99);
}


.lbmOsAnimatedButton:disabled {
  opacity: .65;
  cursor: wait;
}


.lbmOsButtonShine {
  position: absolute;

  top: 0;
  bottom: 0;

  left: -100px;

  width: 70px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.55),
      transparent
    );

  transform:
    skewX(-20deg);

  animation:
    lbmOsButtonShine 3.5s
    ease-in-out infinite;
}


@keyframes lbmOsButtonShine {
  0% {
    left: -100px;
  }

  45%,
  100% {
    left: 110%;
  }
}


.lbmOsButtonContent {
  position: relative;

  z-index: 2;

  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;
}


.lbmOsButtonArrow {
  font-size: 18px;

  transition:
    transform .25s ease;
}


.lbmOsAnimatedButton:hover
.lbmOsButtonArrow {
  transform:
    translateX(4px);
}


.lbmOsSpinner {
  width: 16px;
  height: 16px;

  border:
    2px solid
    rgba(0,0,0,.20);

  border-top-color:
    #171717;

  border-radius: 50%;

  animation:
    lbmOsSpinner .7s linear infinite;
}


@keyframes lbmOsSpinner {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   FOOTER
   ========================================================= */

.lbmOsLoginFooter {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  margin-top: 28px;

  color:
    rgba(255,255,255,.28);

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .16em;
}


.lbmOsFooterDot {
  color:
    rgba(212,175,55,.55);
}


.lbmOsLoginBottom {
  position: absolute;

  bottom: 22px;

  left: 50%;

  transform:
    translateX(-50%);

  width: calc(100% - 40px);

  display: flex;
  justify-content: space-between;

  color:
    rgba(255,255,255,.24);

  font-size: 8px;

  letter-spacing: .14em;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 650px) {
  .lbmOsLoginPage {
    padding:
      100px 16px 70px;
  }

  .lbmOsLoginBrand {
    top: 28px;
  }

  .lbmOsGlassCard {
    border-radius: 22px;
  }

  .lbmOsLoginContent {
    padding:
      36px 24px 25px;

    border-radius: 21px;
  }

  .lbmOsLoginHeader h1 {
    font-size: 46px;
  }

  .lbmOsLoginBottom {
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-align: center;
  }
}


@media (prefers-reduced-motion: reduce) {
  .lbmOsOrb,
  .lbmOsPaintStroke,
  .lbmOsStatusDot,
  .lbmOsButtonShine,
  .lbmOsSpinner,
  .lbmOsGlassCard {
    animation: none;
  }

  .lbmOsInputWrap,
  .lbmOsAnimatedButton,
  .lbmOsPasswordToggle,
  .lbmOsButtonArrow {
    transition: none;
  }
}

/* ============================================================
   DEVELOPMENT LOGIN
   ============================================================ */

.lbmDevAccess {
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid rgba(30, 42, 68, .08);
}

.lbmDevDivider {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 13px;
}

.lbmDevDivider span {
  flex: 1;
  height: 1px;
  background: #dedbd3;
}

.lbmDevDivider small {
  color: #99958d;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .13em;
  white-space: nowrap;
}

.lbmDevLoginButton {
  position: relative;
  width: 100%;
  min-height: 48px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 0 15px;

  border: 1px solid rgba(30, 42, 68, .14);

  background:
    linear-gradient(
      135deg,
      rgba(30, 42, 68, .055),
      rgba(255, 255, 255, .65)
    );

  color: #1e2a44;

  cursor: pointer;

  font: inherit;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .11em;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  transition:
    transform .25s ease,
    border-color .25s ease,
    box-shadow .25s ease,
    background .25s ease;
}

.lbmDevLoginButton:hover:not(:disabled) {
  transform: translateY(-2px);

  border-color: #d4af37;

  background:
    linear-gradient(
      135deg,
      rgba(212,175,55,.12),
      rgba(255,255,255,.85)
    );

  box-shadow:
    0 12px 28px rgba(30,42,68,.09),
    inset 0 1px 0 rgba(255,255,255,.8);
}

.lbmDevLoginButton:active:not(:disabled) {
  transform: translateY(0);
}

.lbmDevLoginButton:disabled {
  opacity: .55;
  cursor: wait;
}

.lbmDevIcon {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(212,175,55,.35);

  background: rgba(212,175,55,.08);

  color: #a47c12;

  font-size: 11px;
}

.lbmDevLoginButton > span:nth-child(2) {
  flex: 1;
  text-align: left;
}

.lbmDevLoginButton strong {
  color: #a47c12;
  font-size: 16px;
  font-weight: 400;

  transition:
    transform .25s ease;
}

.lbmDevLoginButton:hover strong {
  transform: translateX(4px);
}

.lbmDevWarning {
  margin: 10px 0 0;

  color: #aaa7a0;

  font-size: 8px;
  line-height: 1.5;
  text-align: center;
}


/* Development environment indicator */

.lbmDevAccess::before {
  content: "DEV";

  position: absolute;

  top: 14px;
  right: 14px;

  padding: 4px 7px;

  border: 1px solid rgba(212,175,55,.25);

  background: rgba(212,175,55,.08);

  color: #a47c12;

  font-size: 6px;
  font-weight: 900;
  letter-spacing: .12em;
}

/* ==========================================================================
   LITTLE BRUSH MASTERS OS — DASHBOARD
   ========================================================================== */

.lbmOs {
  min-height: 100vh;
  display: flex;
  background: #f8f5ef;
  color: #202634;
}

/* --------------------------------------------------------------------------
   SIDEBAR
   -------------------------------------------------------------------------- */

.osSidebar {
  width: 250px;
  min-width: 250px;
  min-height: 100vh;
  position: sticky;
  top: 0;
  height: 100vh;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 28px 18px;

  background: #1e2a44;
  color: #fff;
}

.osBrand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 4px 10px 10px;
}

.osBrandMark {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255,255,255,.25);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
}

.osBrand strong,
.osBrand span {
  display: block;
  font-size: 10px;
  letter-spacing: .15em;
}

.osBrand span {
  margin-top: 3px;
  opacity: .65;
}

.osBrandSub {
  padding: 8px 10px 28px;

  font-size: 8px;
  font-weight: 700;
  letter-spacing: .16em;

  color: rgba(255,255,255,.4);
}

/* --------------------------------------------------------------------------
   NAVIGATION
   -------------------------------------------------------------------------- */

.osNav {
  display: grid;
  gap: 4px;
}

.osNav button {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 12px;

  border: 0;
  border-radius: 8px;

  background: transparent;
  color: rgba(255,255,255,.68);

  font: inherit;
  font-size: 13px;
  text-align: left;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}

.osNav button:hover {
  background: rgba(255,255,255,.08);
  color: #fff;
}

.osNav button.active {
  background: rgba(255,255,255,.12);
  color: #fff;
}

.osNav button span {
  margin-left: auto;

  min-width: 22px;
  height: 22px;

  display: grid;
  place-items: center;

  border-radius: 999px;

  background: rgba(255,255,255,.1);

  font-size: 10px;
}

.osSidebarBottom {
  padding-top: 20px;

  border-top: 1px solid rgba(255,255,255,.1);
}

.osCapacity {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 10px;
}

.capacityDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #c8d2c0;
  box-shadow: 0 0 0 4px rgba(200,210,192,.08);
}

.osCapacity strong,
.osCapacity small {
  display: block;
}

.osCapacity strong {
  font-size: 11px;
  font-weight: 600;
}

.osCapacity small {
  margin-top: 4px;

  font-size: 9px;

  color: rgba(255,255,255,.45);
}

/* --------------------------------------------------------------------------
   MAIN
   -------------------------------------------------------------------------- */

.osMain {
  flex: 1;
  width: 100%;
  min-width: 0;

  max-width: 1500px;

  margin: 0 auto;

  padding: 55px 6vw 90px;
}

.osHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 42px;
}

.osEyebrow {
  margin: 0 0 12px;

  color: #a47c12;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: .18em;
}

.osHeader h1 {
  margin: 0;

  font-size: clamp(38px, 5vw, 64px);
  line-height: .98;
  letter-spacing: -.045em;
  font-weight: 600;
}

.osHeaderActions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.osRefresh {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 11px 15px;

  border: 1px solid rgba(32,38,52,.12);
  border-radius: 999px;

  background: rgba(255,255,255,.7);

  color: #202634;

  font: inherit;
  font-size: 12px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}

.osRefresh:hover {
  background: #fff;
  transform: translateY(-1px);
}

.osRefresh:disabled {
  opacity: .5;
  cursor: wait;
}

.spin {
  animation: osSpin .7s linear infinite;
}

@keyframes osSpin {
  to {
    transform: rotate(360deg);
  }
}

/* --------------------------------------------------------------------------
   METRICS
   -------------------------------------------------------------------------- */

.metricGrid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;

  margin-bottom: 18px;
}

.metric {
  min-height: 180px;

  display: flex;
  flex-direction: column;

  padding: 24px;

  border: 1px solid rgba(32,38,52,.08);
  border-radius: 18px;

  background: rgba(255,255,255,.78);

  box-shadow:
    0 12px 35px rgba(32,38,52,.045);
}

.metricIcon {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  margin-bottom: 24px;

  border-radius: 10px;

  background: #f1eee7;
  color: #1e2a44;
}

.metricLabel {
  margin-bottom: 7px;

  color: #6d7280;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.metricValue {
  display: block;

  font-size: clamp(24px, 2.5vw, 34px);
  line-height: 1.05;
  letter-spacing: -.04em;
  font-weight: 600;
}

.metricDetail {
  margin-top: auto;

  padding-top: 12px;

  color: #8b9099;

  font-size: 11px;
}

/* --------------------------------------------------------------------------
   DASHBOARD PANELS
   -------------------------------------------------------------------------- */

.dashboardGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(320px, 1fr);

  gap: 18px;
}

.osPanel {
  min-width: 0;

  padding: 28px;

  border: 1px solid rgba(32,38,52,.08);
  border-radius: 18px;

  background: rgba(255,255,255,.78);

  box-shadow:
    0 12px 35px rgba(32,38,52,.045);
}

.panelHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;
}

.panelHeader h3 {
  margin: 0;

  font-size: 22px;
  line-height: 1.1;
  letter-spacing: -.025em;
}

.panelLink {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 0;

  border: 0;
  background: transparent;

  color: #a47c12;

  font: inherit;
  font-size: 11px;
  font-weight: 700;

  cursor: pointer;
}

/* --------------------------------------------------------------------------
   MINI LEADS
   -------------------------------------------------------------------------- */

.miniList {
  display: grid;
}

.miniLead {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 16px 0;

  border: 0;
  border-top: 1px solid rgba(32,38,52,.08);

  background: transparent;

  color: inherit;

  font: inherit;
  text-align: left;

  cursor: pointer;
}

.miniLead:hover strong {
  color: #a47c12;
}

.miniLead strong,
.miniLead span {
  display: block;
}

.miniLead strong {
  margin-bottom: 5px;

  font-size: 13px;
}

.miniLead > div:first-child span {
  color: #7b808a;
  font-size: 11px;
}

.miniLeadRight {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* --------------------------------------------------------------------------
   STATUS
   -------------------------------------------------------------------------- */

.statusBadge {
  display: inline-flex;
  align-items: center;

  padding: 6px 9px;

  border-radius: 999px;

  background: #f1eee7;

  color: #6d7280;

  font-size: 9px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: capitalize;

  white-space: nowrap;
}

.status-qualified,
.status-deposit_paid,
.status-booked {
  background: #e8eee5;
  color: #53634f;
}

.status-proposal_sent,
.status-agreement_sent,
.status-agreement_signed {
  background: #f4edda;
  color: #876914;
}

.status-completed,
.status-closed,
.status-testimonial {
  background: #e6eee9;
  color: #486453;
}

/* --------------------------------------------------------------------------
   REVENUE
   -------------------------------------------------------------------------- */

.revenueRows {
  display: grid;

  border-top: 1px solid rgba(32,38,52,.08);
}

.revenueRow {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 17px 0;

  border-bottom: 1px solid rgba(32,38,52,.08);
}

.revenueRow span {
  color: #6d7280;
  font-size: 12px;
}

.revenueRow strong {
  font-size: 16px;
}

.revenueNote {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-top: 20px;

  color: #a47c12;

  font-size: 11px;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   EMPTY STATE
   -------------------------------------------------------------------------- */

.emptyState,
.emptyDetail {
  padding: 45px 25px;

  text-align: center;

  color: #7b808a;
}

.emptyStateIcon {
  width: 44px;
  height: 44px;

  display: grid;
  place-items: center;

  margin: 0 auto 15px;

  border-radius: 50%;

  background: #f1eee7;
  color: #8c7950;
}

.emptyState h3,
.emptyDetail h3 {
  margin: 0 0 8px;

  color: #202634;

  font-size: 16px;
}

.emptyState p,
.emptyDetail p {
  max-width: 400px;

  margin: 0 auto;

  font-size: 12px;
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   TOOLBAR
   -------------------------------------------------------------------------- */

.osToolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 20px;
}

.searchBox {
  max-width: 600px;
  width: 100%;

  display: flex;
  align-items: center;
  gap: 10px;

  padding: 13px 15px;

  border: 1px solid rgba(32,38,52,.1);
  border-radius: 12px;

  background: #fff;

  color: #8a8f98;
}

.searchBox input {
  width: 100%;

  border: 0;
  outline: 0;

  background: transparent;

  color: #202634;

  font: inherit;
  font-size: 12px;
}

.osResultCount {
  color: #7b808a;

  font-size: 11px;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   CONTENT GRID
   -------------------------------------------------------------------------- */

.osContentGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(340px, .75fr);

  gap: 18px;
}

.osList {
  display: grid;
  gap: 10px;
}

.leadCard {
  width: 100%;

  padding: 20px;

  border: 1px solid rgba(32,38,52,.08);
  border-radius: 14px;

  background: rgba(255,255,255,.8);

  color: #202634;

  font: inherit;
  text-align: left;

  cursor: pointer;

  transition:
    border .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}

.leadCard:hover,
.leadCard.selected {
  border-color: rgba(164,124,18,.4);

  box-shadow:
    0 10px 30px rgba(32,38,52,.06);

  transform: translateY(-1px);
}

.leadCardTop {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;
}

.leadCardTop strong,
.leadCardTop span {
  display: block;
}

.leadCardTop strong {
  font-size: 14px;
}

.leadCardTop div span {
  margin-top: 5px;

  color: #7b808a;

  font-size: 11px;
}

.leadCardMeta {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-top: 18px;

  color: #6d7280;

  font-size: 11px;
}

.leadCardMeta span {
  display: flex;
  align-items: center;
  gap: 5px;
}

.leadCard > small {
  display: block;

  margin-top: 16px;

  color: #a0a4ab;

  font-size: 10px;
}

/* --------------------------------------------------------------------------
   DETAIL PANEL
   -------------------------------------------------------------------------- */

.detailPanel,
.projectDetail {
  padding: 28px;

  border: 1px solid rgba(32,38,52,.08);
  border-radius: 18px;

  background: rgba(255,255,255,.82);

  box-shadow:
    0 12px 35px rgba(32,38,52,.045);
}

.detailHeader,
.projectDetailHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 28px;
}

.detailHeader h2,
.projectDetailHeader h2 {
  margin: 0 0 7px;

  font-size: 25px;
  letter-spacing: -.03em;
}

.detailHeader span,
.projectDetailHeader span {
  color: #7b808a;
  font-size: 11px;
}

.detailFacts,
.projectDetailMeta {
  display: grid;
  gap: 10px;

  margin-bottom: 25px;
}

.fact {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 12px 0;

  border-bottom: 1px solid rgba(32,38,52,.06);
}

.factIcon {
  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border-radius: 8px;

  background: #f1eee7;
  color: #6d7280;
}

.fact span,
.fact strong {
  display: block;
}

.fact span {
  margin-bottom: 4px;

  color: #8b9099;

  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.fact strong {
  font-size: 12px;
  line-height: 1.4;
}

.detailBlock {
  margin-top: 22px;
}

.detailBlock > span {
  display: block;

  margin-bottom: 8px;

  color: #8b9099;

  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.detailBlock p {
  margin: 0;

  color: #4f5663;

  font-size: 12px;
  line-height: 1.65;
}

.detailActions,
.projectDetailActions {
  display: grid;
  gap: 9px;

  margin-top: 28px;
}

.osButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 42px;

  padding: 10px 15px;

  border-radius: 10px;

  font: inherit;
  font-size: 11px;
  font-weight: 700;

  cursor: pointer;

  transition:
    transform .2s ease,
    opacity .2s ease;
}

.osButton:hover {
  transform: translateY(-1px);
}

.osButton.primary {
  border: 1px solid #1e2a44;

  background: #1e2a44;
  color: #fff;
}

.osButton.secondary {
  border: 1px solid rgba(32,38,52,.12);

  background: #fff;
  color: #202634;
}

.conversionNotice,
.completedNotice {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-top: 16px;
  padding: 12px;

  border-radius: 9px;

  background: #e8eee5;

  color: #53634f;

  font-size: 10px;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   CLIENTS
   -------------------------------------------------------------------------- */

.osSectionIntro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;
}

.osSectionIntro h2 {
  margin: 0;

  font-size: 30px;
  letter-spacing: -.035em;
}

.osSectionIntro > strong {
  font-size: 12px;
  color: #6d7280;
}

.clientGrid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.clientCard {
  display: flex;
  gap: 16px;

  padding: 22px;

  border: 1px solid rgba(32,38,52,.08);
  border-radius: 16px;

  background: #fff;
}

.clientAvatar {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #1e2a44;
  color: #fff;

  font-size: 13px;
  font-weight: 700;
}

.clientMain {
  min-width: 0;
  flex: 1;
}

.clientTop {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.clientTop h3 {
  margin: 0 0 5px;

  font-size: 15px;
}

.clientTop span {
  display: block;

  margin-top: 3px;

  color: #7b808a;

  font-size: 10px;
}

.clientStatus {
  height: fit-content;

  padding: 5px 8px;

  border-radius: 999px;

  background: #e8eee5;
  color: #53634f;

  font-size: 9px;
  font-weight: 700;
  text-transform: capitalize;
}

.clientChildren {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;

  margin-top: 15px;
}

.clientChildren span {
  padding: 6px 8px;

  border-radius: 7px;

  background: #f5f2eb;

  color: #6d7280;

  font-size: 10px;
}

.clientFooter {
  display: flex;
  justify-content: space-between;

  margin-top: 18px;
  padding-top: 14px;

  border-top: 1px solid rgba(32,38,52,.07);

  color: #7b808a;

  font-size: 10px;
}

.clientFooter strong {
  color: #202634;
}

/* --------------------------------------------------------------------------
   PIPELINE
   -------------------------------------------------------------------------- */

.pipelineBoard {
  display: flex;

  gap: 12px;

  overflow-x: auto;

  padding-bottom: 10px;
}

.pipelineColumn {
  width: 245px;
  min-width: 245px;

  padding: 12px;

  border-radius: 14px;

  background: #eeece6;
}

.pipelineColumnHead {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 5px 4px 12px;
}

.pipelineColumnHead span {
  color: #6d7280;

  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.pipelineColumnHead strong {
  min-width: 20px;
  height: 20px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: rgba(32,38,52,.08);

  font-size: 9px;
}

.projectCard {
  width: 100%;

  display: block;

  margin-bottom: 8px;
  padding: 15px;

  border: 1px solid rgba(32,38,52,.07);
  border-radius: 11px;

  background: #fff;

  color: #202634;

  font: inherit;
  text-align: left;

  cursor: pointer;

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.projectCard:hover,
.projectCard.selected {
  transform: translateY(-1px);

  box-shadow:
    0 8px 20px rgba(32,38,52,.08);
}

.projectCardTop {
  display: flex;
  justify-content: space-between;

  gap: 8px;

  margin-bottom: 10px;
}

.projectCardTop span {
  font-size: 12px;
  font-weight: 700;
}

.projectCardTop small {
  color: #a47c12;
  font-size: 9px;
}

.projectCard > strong {
  display: block;

  font-size: 11px;
}

.projectCard > small {
  display: block;

  margin-top: 6px;

  color: #7b808a;

  font-size: 9px;
}

.pipelineEmpty {
  padding: 25px 10px;

  text-align: center;

  color: #9a9da3;

  font-size: 10px;
}

/* --------------------------------------------------------------------------
   PROJECT DETAIL
   -------------------------------------------------------------------------- */

.projectDetail {
  margin-top: 20px;
}

.projectDetailStats {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 10px;

  margin-bottom: 25px;
}

.projectDetailStats > div {
  padding: 16px;

  border-radius: 10px;

  background: #f5f2eb;
}

.projectDetailStats span,
.projectDetailStats strong {
  display: block;
}

.projectDetailStats span {
  margin-bottom: 7px;

  color: #8b9099;

  font-size: 9px;
  text-transform: uppercase;
}

.projectDetailStats strong {
  font-size: 15px;
}

.projectProgress {
  display: grid;

  grid-template-columns:
    repeat(14, minmax(50px, 1fr));

  gap: 4px;

  margin-top: 28px;

  overflow-x: auto;
}

.progressStage {
  position: relative;

  min-width: 55px;

  text-align: center;
}

.progressStage > span {
  display: block;

  height: 5px;

  margin-bottom: 7px;

  border-radius: 999px;

  background: #dedbd4;
}

.progressStage.done > span {
  background: #c8d2c0;
}

.progressStage.current > span {
  background: #a47c12;
}

.progressStage small {
  color: #8b9099;

  font-size: 7px;
  line-height: 1.2;
}

/* --------------------------------------------------------------------------
   RESPONSIVE
   -------------------------------------------------------------------------- */

@media (max-width: 1100px) {
  .metricGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .dashboardGrid {
    grid-template-columns: 1fr;
  }

  .osContentGrid {
    grid-template-columns: 1fr;
  }

  .clientGrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .lbmOs {
    display: block;
  }

  .osSidebar {
    width: 100%;
    min-width: 0;
    min-height: auto;
    height: auto;

    position: relative;

    padding: 15px;
  }

  .osBrandSub {
    display: none;
  }

  .osNav {
    grid-template-columns:
      repeat(4, 1fr);
  }

  .osNav button {
    justify-content: center;
    padding: 10px 6px;

    font-size: 10px;
  }

  .osNav button span {
    display: none;
  }

  .osSidebarBottom {
    display: none;
  }

  .osMain {
    padding: 35px 20px 60px;
  }

  .osHeader {
    align-items: flex-start;
    flex-direction: column;
  }

  .osHeader h1 {
    font-size: 42px;
  }

  .metricGrid {
    grid-template-columns: 1fr;
  }

  .projectDetailStats {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .osNav {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .osSectionIntro {
    align-items: flex-start;
    flex-direction: column;
  }

  .projectDetailStats {
    grid-template-columns: 1fr;
  }
}